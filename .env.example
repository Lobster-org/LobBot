# Runtime
ENVIRONMENT=production
LOG_LEVEL=INFO
RUNNING_IN_DOCKER=false

# Get these from telegram developer page
TELEGRAM_API_ID=API_ID_HERE
TELEGRAM_API_HASH=API_HASH_HERE

# Provide by Bot-Father from telegram
TELEGRAM_BOT_TOKEN=BOT_TOKEN_HERE

VOICE_SESSION_NAME=lobbot_voice

# MongoDB connection string (defaults to localhost if not set)
MONGO_ROOT_USERNAME=lobadmin
# Use URL-safe characters because this value is embedded in a MongoDB URI.
MONGO_ROOT_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=lobbot

# Redis connection stirng
REDIS_URI=redis://unused:6379/0

MUSIC_STORAGE_PATH=storage/music

# Shared external API client
HTTP_TIMEOUT_SECONDS=12
HTTP_USER_AGENT=LobBot/2.0

# Required for /movie and /tv. Use TMDB's API Read Access Token.
TMDB_BEARER_TOKEN=

# Local terminal default. Docker Compose overrides this with the private
# http://libretranslate:5000 service address.
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=
TRANSLATION_DEFAULT_LANGUAGE=en
LIBRETRANSLATE_LANGUAGES=en,es,fr,de,it,pt,ar,ja,ko,zh,ru
